{
  "chat.editor.fontFamily": "JetBrains Mono",
  "chat.editor.fontSize": 16,
  "chat.fontFamily": "Montserrat",
  "debug.console.fontFamily": "JetBrains Mono",
  "debug.console.fontSize": 16,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 16,
  "editor.codeLensFontStyle": "italic",
  "editor.inlineSuggest.fontFamily": "JetBrains Mono",
  "editor.inlayHints.fontSize": 11,
  "editor.minimap.sectionHeaderFontSize": 10,
  "markdown.preview.fontFamily": "Montserrat",
  "markdown.preview.fontSize": 16,
  "notebook.markup.fontFamily": "Montserrat",
  "scm.inputFontFamily": "JetBrains Mono",
  "scm.inputFontSize": 15,
  "screencastMode.fontSize": 64,
  "terminal.integrated.fontSize": 16,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "update.mode": "none",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/run/current-system/sw/bin/bash"
    }
  },
  "terminal.integrated.automationProfile.linux": {
    "path": "/run/current-system/sw/bin/bash"
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "focusBorder": "#7aa2f7",
    "foreground": "#c0caf5",
    "editor.background": "#000000",
    "editor.foreground": "#c0caf5",
    "editorLineNumber.foreground": "#9aa5ce",
    "editorLineNumber.activeForeground": "#7aa2f7",
    "editorCursor.foreground": "#7aa2f7",
    "editor.selectionBackground": "#36436480",
    "editor.inactiveSelectionBackground": "#0f132560",
    "sideBar.background": "#0f1325",
    "sideBar.foreground": "#c0caf5",
    "sideBar.border": "#5d6682",
    "sideBarTitle.foreground": "#c0caf5",
    "sideBarSectionHeader.background": "#171c32",
    "sideBarSectionHeader.foreground": "#c0caf5",
    "activityBar.background": "#0f1325",
    "activityBar.foreground": "#c0caf5",
    "activityBar.inactiveForeground": "#9aa5ce",
    "activityBar.activeBorder": "#7aa2f7",
    "activityBarBadge.background": "#7aa2f7",
    "activityBarBadge.foreground": "#16161e",
    "statusBar.background": "#080a18",

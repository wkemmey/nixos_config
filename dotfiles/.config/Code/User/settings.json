    "statusBar.border": "#76706c",
    "statusBar.noFolderBackground": "#0f0e0d",
    "titleBar.activeBackground": "#191615",
    "titleBar.activeForeground": "#fbf1c7",
    "titleBar.inactiveBackground": "#191615",
    "titleBar.inactiveForeground": "#ebdbb2",
    "titleBar.border": "#76706c",
    "tab.activeBackground": "#000000",

{
  "chat.editor.fontFamily": "JetBrains Mono",
  "chat.editor.fontSize": 16,
  "chat.fontFamily": "Montserrat",
  "debug.console.fontFamily": "JetBrains Mono",
  "debug.console.fontSize": 16,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 16,
  "editor.codeLensFontStyle": "italic",
  "editor.inlineSuggest.fontFamily": "JetBrains Mono",
  "editor.inlayHints.fontSize": 11,
  "editor.minimap.sectionHeaderFontSize": 10,
  "markdown.preview.fontFamily": "Montserrat",
  "markdown.preview.fontSize": 16,
  "notebook.markup.fontFamily": "Montserrat",
  "scm.inputFontFamily": "JetBrains Mono",
  "scm.inputFontSize": 15,
  "screencastMode.fontSize": 64,
  "terminal.integrated.fontSize": 16,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "update.mode": "none",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/run/current-system/sw/bin/bash"
    }
  },
  "terminal.integrated.automationProfile.linux": {
    "path": "/run/current-system/sw/bin/bash"
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "focusBorder": "#b58900",
    "foreground": "#839496",
    "editor.background": "#000000",
    "editor.foreground": "#839496",
    "editorLineNumber.foreground": "#657b83",
    "editorLineNumber.activeForeground": "#b58900",
    "editorCursor.foreground": "#b58900",
    "editor.selectionBackground": "#4d3a0080",
    "editor.inactiveSelectionBackground": "#000c1160",
    "sideBar.background": "#000c11",
    "sideBar.foreground": "#839496",
    "sideBar.border": "#31788d",
    "sideBarTitle.foreground": "#839496",
    "sideBarSectionHeader.background": "#001d26",
    "sideBarSectionHeader.foreground": "#839496",
    "activityBar.background": "#000c11",
    "activityBar.foreground": "#839496",
    "activityBar.inactiveForeground": "#657b83",
    "activityBar.activeBorder": "#b58900",
    "activityBarBadge.background": "#b58900",
    "activityBarBadge.foreground": "#002b36",
    "statusBar.background": "#000609",
    "statusBar.foreground": "#839496",
    "statusBar.border": "#31788d",
    "statusBar.noFolderBackground": "#000609",
    "titleBar.activeBackground": "#000c11",
    "titleBar.activeForeground": "#839496",
    "titleBar.inactiveBackground": "#000c11",
    "titleBar.inactiveForeground": "#657b83",
    "titleBar.border": "#31788d",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#839496",
    "tab.activeBorder": "#b58900",
    "tab.inactiveBackground": "#000c11",
    "tab.inactiveForeground": "#657b83",
    "tab.border": "#31788d",
    "panel.background": "#000000",
    "panel.border": "#31788d",
    "panelTitle.activeBorder": "#b58900",
    "panelTitle.activeForeground": "#839496",
    "panelTitle.inactiveForeground": "#657b83",
    "list.activeSelectionBackground": "#4d3a00",
    "list.activeSelectionForeground": "#fff3cc",
    "list.inactiveSelectionBackground": "#000c11",
    "list.hoverBackground": "#002a36",
    "list.focusOutline": "#b58900",
    "button.background": "#b58900",
    "button.foreground": "#002b36",
    "button.hoverBackground": "#4d3a00",
    "input.background": "#002a36",
    "input.foreground": "#839496",
    "input.border": "#31788d",
    "input.placeholderForeground": "#657b83",
    "terminal.foreground": "#839496",
    "terminal.background": "#000000",
    "terminal.ansiBlack": "#000609",
    "terminal.ansiRed": "#dc322f",
    "terminal.ansiGreen": "#cb4b16",
    "terminal.ansiYellow": "#d33682",
    "terminal.ansiBlue": "#b58900",
    "terminal.ansiMagenta": "#cb4b16",
    "terminal.ansiCyan": "#d33682",
    "terminal.ansiWhite": "#839496",
    "notificationCenter.border": "#31788d",
    "notifications.background": "#000c11",
    "notifications.foreground": "#839496",
    "notifications.border": "#31788d",
    "editorInlayHint.foreground": "#666666",

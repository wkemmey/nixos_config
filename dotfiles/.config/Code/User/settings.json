    "statusBar.border": "#5d6682",
    "statusBar.noFolderBackground": "#080a18",
    "titleBar.activeBackground": "#0f1325",
    "titleBar.activeForeground": "#c0caf5",
    "titleBar.inactiveBackground": "#0f1325",
    "titleBar.inactiveForeground": "#9aa5ce",
    "titleBar.border": "#5d6682",

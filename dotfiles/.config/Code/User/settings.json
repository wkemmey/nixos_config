{
  "chat.editor.fontFamily": "JetBrains Mono",
  "chat.editor.fontSize": 16,
  "chat.fontFamily": "Montserrat",
  "debug.console.fontFamily": "JetBrains Mono",
  "debug.console.fontSize": 16,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 16,
  "editor.codeLensFontStyle": "italic",
  "editor.inlineSuggest.fontFamily": "JetBrains Mono",
  "editor.inlayHints.fontSize": 11,
  "editor.minimap.sectionHeaderFontSize": 10,
  "markdown.preview.fontFamily": "Montserrat",
  "markdown.preview.fontSize": 16,
  "notebook.markup.fontFamily": "Montserrat",
  "scm.inputFontFamily": "JetBrains Mono",
  "scm.inputFontSize": 15,
  "screencastMode.fontSize": 64,
  "terminal.integrated.fontSize": 16,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "update.mode": "none",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/run/current-system/sw/bin/bash"
    }
  },
  "terminal.integrated.automationProfile.linux": {
    "path": "/run/current-system/sw/bin/bash"
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "focusBorder": "#76946a",
    "foreground": "#c8c093",
    "editor.background": "#000000",
    "editor.foreground": "#c8c093",
    "editorLineNumber.foreground": "#717c7c",
    "editorLineNumber.activeForeground": "#76946a",
    "editorCursor.foreground": "#76946a",
    "editor.selectionBackground": "#39423b80",
    "editor.inactiveSelectionBackground": "#11111d60",
    "sideBar.background": "#11111d",
    "sideBar.foreground": "#c8c093",
    "sideBar.border": "#68697a",
    "sideBarTitle.foreground": "#c8c093",
    "sideBarSectionHeader.background": "#191a29",
    "sideBarSectionHeader.foreground": "#c8c093",
    "activityBar.background": "#11111d",
    "activityBar.foreground": "#c8c093",
    "activityBar.inactiveForeground": "#717c7c",
    "activityBar.activeBorder": "#76946a",
    "activityBarBadge.background": "#76946a",
    "activityBarBadge.foreground": "#1f1f28",
    "statusBar.background": "#080812",
    "statusBar.foreground": "#c8c093",
    "statusBar.border": "#68697a",
    "statusBar.noFolderBackground": "#080812",
    "titleBar.activeBackground": "#11111d",
    "titleBar.activeForeground": "#c8c093",
    "titleBar.inactiveBackground": "#11111d",
    "titleBar.inactiveForeground": "#717c7c",
    "titleBar.border": "#68697a",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#c8c093",

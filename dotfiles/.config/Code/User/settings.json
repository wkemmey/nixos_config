{
  "chat.editor.fontFamily": "JetBrains Mono",
  "chat.editor.fontSize": 16,
  "chat.fontFamily": "Montserrat",
  "debug.console.fontFamily": "JetBrains Mono",
  "debug.console.fontSize": 16,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 16,
  "editor.codeLensFontStyle": "italic",
  "editor.inlineSuggest.fontFamily": "JetBrains Mono",
  "editor.inlayHints.fontSize": 11,
  "editor.minimap.sectionHeaderFontSize": 10,
  "markdown.preview.fontFamily": "Montserrat",
  "markdown.preview.fontSize": 16,
  "notebook.markup.fontFamily": "Montserrat",
  "scm.inputFontFamily": "JetBrains Mono",
  "scm.inputFontSize": 15,
  "screencastMode.fontSize": 64,
  "terminal.integrated.fontSize": 16,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "update.mode": "none",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/run/current-system/sw/bin/bash"
    }
  },
  "terminal.integrated.automationProfile.linux": {
    "path": "/run/current-system/sw/bin/bash"
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "focusBorder": "#b85a30",
    "foreground": "#e6dbd3",
    "editor.background": "#000000",
    "editor.foreground": "#e6dbd3",
    "editorLineNumber.foreground": "#b8aca2",
    "editorLineNumber.activeForeground": "#b85a30",
    "editorCursor.foreground": "#b85a30",
    "editor.selectionBackground": "#3f1d0d80",
    "editor.inactiveSelectionBackground": "#150e0c60",
    "sideBar.background": "#150e0c",
    "sideBar.foreground": "#e6dbd3",
    "sideBar.border": "#716763",
    "sideBarTitle.foreground": "#e6dbd3",
    "sideBarSectionHeader.background": "#211915",
    "sideBarSectionHeader.foreground": "#e6dbd3",
    "activityBar.background": "#150e0c",
    "activityBar.foreground": "#e6dbd3",
    "activityBar.inactiveForeground": "#b8aca2",
    "activityBar.activeBorder": "#b85a30",
    "activityBarBadge.background": "#b85a30",
    "activityBarBadge.foreground": "#1d1816",
    "statusBar.background": "#0c0705",
    "statusBar.foreground": "#e6dbd3",
    "statusBar.border": "#716763",
    "statusBar.noFolderBackground": "#0c0705",
    "titleBar.activeBackground": "#150e0c",
    "titleBar.activeForeground": "#e6dbd3",
    "titleBar.inactiveBackground": "#150e0c",
    "titleBar.inactiveForeground": "#b8aca2",
    "titleBar.border": "#716763",
    "tab.activeBackground": "#000000",

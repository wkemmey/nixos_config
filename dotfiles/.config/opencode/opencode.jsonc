{
  "$schema": "https://opencode.ai/config.json",
  "shell": "fish",
  "share": "manual",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "build",

  // Lightweight/background agents on the cheap flash model. `title` uses the
  // free OpenCode model; the rest use your paid flash. Switch them to
  // "opencode/deepseek-v4.1-flash-free" after you sign in, if you like.
  "agents": {
    "title":      { "model": "opencode/deepseek-v4.1-flash-free" },
    "summary":    { "model": "deepseek/deepseek-flash" },
    "compaction": { "model": "deepseek/deepseek-flash" },
    "explore":    { "model": "deepseek/deepseek-flash" }
  },

  // Ordered rules: the last match wins.
  "permissions": [
    // Shell: ask by default...
    { "action": "shell", "resource": "*", "effect": "ask" },

    // ...but let read-only inspection run silently.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *",  "effect": "allow" },
    { "action": "shell", "resource": "git log *",   "effect": "allow" },
    { "action": "shell", "resource": "git show *",  "effect": "allow" },
    { "action": "shell", "resource": "ls *",        "effect": "allow" },
    { "action": "shell", "resource": "cat *",       "effect": "allow" },
    { "action": "shell", "resource": "pwd *",       "effect": "allow" },
    { "action": "shell", "resource": "which *",     "effect": "allow" },
    { "action": "shell", "resource": "grep *",      "effect": "allow" },
    { "action": "shell", "resource": "rg *",        "effect": "allow" },
    { "action": "shell", "resource": "find *",      "effect": "allow" },

    // Irreversibly destructive: block outright. Delete these lines if you'd
    // rather just be asked instead.
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *",      "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*",          "effect": "deny" },

    // Ask before reading/writing anything outside this project (V1 behavior;
    // V2 turned it off).
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Allow reading the NixOS system config without prompting.
    { "action": "external_directory", "resource": "/etc/nixos/*", "effect": "allow" },
    { "action": "read", "resource": "/etc/nixos/*", "effect": "allow" }
  ],

  // Efficiency / quality-of-life.
  "experimental": {
    "todo": true,
    "background_compaction": true
  },
  "formatter": true,
  "watcher": {
    "ignore": ["result", "node_modules/**", "dist/**", "target/**"]
  }
}

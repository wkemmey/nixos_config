{
  "$schema": "https://opencode.ai/config.json",
  "shell": "fish",
  "share": "manual",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "build",

  // Lightweight/background agents on the cheap flash model. `title` uses the
  // free OpenCode model; the rest use your paid flash. Switch them to
  // "opencode/deepseek-v4.1-flash-free" after you sign in, if you like.
  "agents": {
    "title":      { "model": "opencode/deepseek-v4.1-flash-free" },
    "summary":    { "model": "deepseek/deepseek-flash" },
    "compaction": { "model": "deepseek/deepseek-flash" },
    "explore":    { "model": "deepseek/deepseek-flash" }
  },

  // Ordered rules: the last match wins.
  "permissions": [
    // Shell: ask by default...
    { "action": "shell", "resource": "*", "effect": "ask" },

    // ...but let read-only inspection run silently.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *",  "effect": "allow" },
    { "action": "shell", "resource": "git log *",   "effect": "allow" },
    { "action": "shell", "resource": "git show *",  "effect": "allow" },
    { "action": "shell", "resource": "ls *",        "effect": "allow" },
    { "action": "shell", "resource": "cat *",       "effect": "allow" },
    { "action": "shell", "resource": "pwd *",       "effect": "allow" },
    { "action": "shell", "resource": "which *",     "effect": "allow" },
    { "action": "shell", "resource": "grep *",      "effect": "allow" },
    { "action": "shell", "resource": "rg *",        "effect": "allow" },

    // NixOS / system inspection (all read-only).
    { "action": "shell", "resource": "systemctl *status *",            "effect": "allow" },
    { "action": "shell", "resource": "systemctl *list-units *",        "effect": "allow" },
    { "action": "shell", "resource": "systemctl *list-unit-files *",   "effect": "allow" },
    { "action": "shell", "resource": "systemctl *cat *",               "effect": "allow" },
    { "action": "shell", "resource": "systemctl *show *",              "effect": "allow" },
    { "action": "shell", "resource": "systemctl *is-enabled *",        "effect": "allow" },
    { "action": "shell", "resource": "systemctl *is-active *",         "effect": "allow" },
    { "action": "shell", "resource": "systemctl *is-failed *",         "effect": "allow" },
    { "action": "shell", "resource": "systemctl *show-environment *",  "effect": "allow" },
    { "action": "shell", "resource": "systemctl *list-dependencies *", "effect": "allow" },
    { "action": "shell", "resource": "journalctl *",                   "effect": "allow" },
    { "action": "shell", "resource": "pgrep *",                        "effect": "allow" },
    { "action": "shell", "resource": "ps *",                           "effect": "allow" },
    { "action": "shell", "resource": "free *",                         "effect": "allow" },
    { "action": "shell", "resource": "df *",                           "effect": "allow" },
    { "action": "shell", "resource": "du *",                           "effect": "allow" },
    { "action": "shell", "resource": "lsblk *",                        "effect": "allow" },
    { "action": "shell", "resource": "findmnt *",                      "effect": "allow" },
    { "action": "shell", "resource": "lsusb *",                        "effect": "allow" },
    { "action": "shell", "resource": "lspci *",                        "effect": "allow" },
    { "action": "shell", "resource": "nproc *",                        "effect": "allow" },
    { "action": "shell", "resource": "uptime *",                       "effect": "allow" },

    // Text processing (read-only, used constantly in pipes).
    { "action": "shell", "resource": "jq *",     "effect": "allow" },
    { "action": "shell", "resource": "sed *",    "effect": "allow" },
    { "action": "shell", "resource": "awk *",    "effect": "allow" },
    { "action": "shell", "resource": "head *",   "effect": "allow" },
    { "action": "shell", "resource": "tail *",   "effect": "allow" },
    { "action": "shell", "resource": "wc *",     "effect": "allow" },
    { "action": "shell", "resource": "sort *",   "effect": "allow" },
    { "action": "shell", "resource": "uniq *",   "effect": "allow" },
    { "action": "shell", "resource": "cut *",    "effect": "allow" },
    { "action": "shell", "resource": "tr *",     "effect": "allow" },
    { "action": "shell", "resource": "column *", "effect": "allow" },

    // `find` is fine for listing, but block its destructive flags.
    { "action": "shell", "resource": "find *",            "effect": "allow" },
    { "action": "shell", "resource": "find * -delete *",  "effect": "deny" },
    { "action": "shell", "resource": "find * -exec *",    "effect": "deny" },
    { "action": "shell", "resource": "find * -execdir *", "effect": "deny" },

    // Dropbox CLI status (read-only).
    { "action": "shell", "resource": "dropbox status *",     "effect": "allow" },
    { "action": "shell", "resource": "dropbox filestatus *", "effect": "allow" },

    // Irreversibly destructive: block outright. Delete these lines if you'd
    // rather just be asked instead.
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *",      "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*",          "effect": "deny" },

    // Ask before reading/writing anything outside this project (V1 behavior;
    // V2 turned it off).
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Allow reading the NixOS system config without prompting.
    { "action": "external_directory", "resource": "/etc/nixos/*", "effect": "allow" },
    { "action": "read", "resource": "/etc/nixos/*", "effect": "allow" }
  ],

  // Efficiency / quality-of-life.
  "experimental": {
    "todo": true,
    "background_compaction": true
  },
  "formatter": true,
  "watcher": {
    "ignore": ["result", "node_modules/**", "dist/**", "target/**"]
  }
}
